# URL da API FastAPI (não é o domínio do site).
# Produção: o Android e o site falam com a mesma origem.
VITE_API_BASE_URL=https://well-paid-psi.vercel.app

# Dev local (backend na máquina):
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Caminho secreto do painel (NÃO uses prefixo VITE_ — não pode ir para o JS público).
# Também definir SUPERADMIN_PATH no painel da Vercel (Production + Preview).
# SUPERADMIN_PATH=/cole-um-caminho-secreto-aqui
# SUPERADMIN_API_PREFIX=/sa-api
